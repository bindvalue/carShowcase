# ═══════════════════════════════════════════════════════
# SUPABASE
# ═══════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ═══════════════════════════════════════════════════════
# ASAAS
# ═══════════════════════════════════════════════════════
# Sandbox: https://sandbox.asaas.com/api/v3
# Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3

# ⚠️ A chave do Asaas começa com "$" (ex: $aact_prod_...)
# No .env.local local, coloque SEM o "$" (o código adiciona)
# No painel do Cloudflare/Vercel, cole COM o "$"
ASAAS_API_KEY=aact_prod_sua_chave_aqui
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_aqui
ASAAS_NOTIFICATION_PHONE=5531999999999